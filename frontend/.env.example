# Backend origin used only by the Next.js server-side development proxy.
RAG_API_ORIGIN=http://localhost:8000

# Development-only identity forwarded by the proxy. Never use production credentials here.
RAG_DEV_USER_ID=user-demo
RAG_DEV_TENANT_ID=tenant-demo

# Set to true to make the browser API client return deterministic F0 mock responses.
NEXT_PUBLIC_USE_API_MOCKS=false
